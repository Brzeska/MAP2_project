# Machine-specific environment.
# env.sh redirects XDG dirs + pixi into the project, so all of this is local state.
# Rebuild on a new machine with: source env.sh, then the steps in colabfold_workflow.txt
.cache/
.config/
.pixi-home/
localcolabfold/

# Regenerable ColabFold intermediates (MSAs are re-downloaded from the MMseqs2 server)
*.a3m
*_env/
*.done.txt

# Scratch test run
test_out/

# OS / editor cruft
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*~

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
